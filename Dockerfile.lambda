FROM public.ecr.aws/lambda/nodejs:20 AS builder

WORKDIR /app
COPY package.json package-lock.json ./

# Install all dependencies needed for building
RUN npm install

# Install transformers for local embeddings
RUN npm install @xenova/transformers

ENV TRANSFORMERS_CACHE=/app/model-cache
# Pre-download the embedding model so it's baked into the image
RUN node -e "(async () => { const { pipeline } = require('@xenova/transformers'); await pipeline('feature-extraction', 'Xenova/multilingual-e5-small', { cache_dir: '/app/model-cache' }); })()"

COPY . .
RUN npm install lightningcss-linux-x64-gnu lightningcss-linux-x64-musl @tailwindcss/oxide-linux-x64-gnu --save-optional
RUN npm run build

FROM node:20-slim

# Install system libraries required by ONNX Runtime (libonnxruntime.so)
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Lambda Web Adapter
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.0 /lambda-adapter /opt/extensions/lambda-adapter

# Copy Next.js standalone build
COPY --from=builder /app/.next/standalone ./

COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# Copy transformers package and pre-downloaded model cache for local embeddings
COPY --from=builder /app/node_modules/@xenova/transformers ./node_modules/@xenova/transformers
COPY --from=builder /app/node_modules/onnxruntime-node/bin/ /app/node_modules/onnxruntime-node/bin/
COPY --from=builder /app/model-cache ./model-cache

RUN mkdir -p /tmp/cache && ln -s /tmp/cache /app/.next/cache

ENV PORT=3000
ENV HOST=0.0.0.0
ENV AWS_LWA_HOST=127.0.0.1
ENV NODE_ENV=production
ENV TRANSFORMERS_CACHE=/app/model-cache
ENV LD_LIBRARY_PATH=/app/node_modules/onnxruntime-node/bin/napi-v3/linux/x64:$LD_LIBRARY_PATH
CMD ["node", "server.js"]